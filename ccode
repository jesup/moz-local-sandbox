#!/bin/bash
#
# ccode — launch claude inside a bwrap sandbox.
#
# bwrap (bubblewrap) creates a lightweight container using unprivileged Linux
# user namespaces: bind mounts and FS isolation without root. The whole script
# is one bwrap invocation; the trailing args run claude inside the container.
#
# Network is intentionally shared (--share-net): mach, cargo, gh, claude all
# need it. Network filtering is expected to be handled out-of-band by a
# separate filtering proxy.

set -euo pipefail

# Source tree exposed read-write to the sandbox. Override with CCODE_SRC if
# your checkouts live elsewhere. Set CCODE_CWD_ONLY=1 to expose only the
# current working directory instead of the whole tree — tighter blast radius
# at the cost of cross-repo work.
SRC="${CCODE_SRC:-$HOME/src}"
CWD="$(pwd)"
if [[ "${CCODE_CWD_ONLY:-0}" == "1" ]]; then
    RW_ROOT="$CWD"
else
    RW_ROOT="$SRC"
fi

# Sandbox-private homes for language toolchains. The host's caches are NOT
# shared into the sandbox: a compromised agent must not be able to drop a
# malicious binary into ~/.cargo/bin, poison a crate in the cargo registry,
# replace a wheel in the uv cache, etc., and have the host pick it up later.
# The host toolchain binaries (rustup-managed rustc/cargo) are still exposed
# read-only so we don't have to re-download them.
SBX="$HOME/.sandbox"
mkdir -p \
    "$SBX/cargo" \
    "$SBX/uv" \
    "$SBX/npm" \
    "$SBX/npm-prefix" \
    "$SBX/pip" \
    "$SBX/go" \
    "$SBX/empty-hooks"

# Build the bwrap argv as an array. Bash does not allow `# comment` lines
# between `\`-continued lines, so the previous form silently broke the command
# into separate one-token invocations of bwrap. Use an array instead.
args=(
    # --- Read-only system directories ---
    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind-try /snap /snap

    # --- Read-only network / auth config ---
    # resolv.conf and hosts: DNS for mach, gh, etc.
    # ssl: CA bundle for HTTPS.
    # passwd, group: uid/gid -> name resolution.
    --ro-bind /etc/resolv.conf      /etc/resolv.conf
    --ro-bind-try /etc/alternatives/cc  /etc/alternatives/cc  # absent on Fedora and newer distros
    --ro-bind /etc/hosts            /etc/hosts
    --ro-bind-try /etc/ssl          /etc/ssl
    --ro-bind-try /etc/pki          /etc/pki
    --ro-bind /etc/passwd           /etc/passwd
    --ro-bind /etc/group            /etc/group

    # --- Read-only credentials and tool config ---
    # Readable so claude can authenticate; not writable so it cannot tamper.
    # (Note: RO does not prevent exfiltration. Bearer tokens here remain
    # within reach of a compromised agent — see README.)
    --ro-bind "$HOME/.gitconfig"             "$HOME/.gitconfig"
    --ro-bind "$HOME/.nvm"                   "$HOME/.nvm"
    --ro-bind "$HOME/.local/bin"             "$HOME/.local/bin"
    --ro-bind "$HOME/.local/share/claude"    "$HOME/.local/share/claude"
    --ro-bind "$HOME/.arcrc"                 "$HOME/.arcrc"
    --ro-bind "$HOME/.config/gh"             "$HOME/.config/gh"
    --ro-bind-try "$HOME/.config/claude"     "$HOME/.config/claude"  # may not exist; mcp-servers.json searched explicitly below
    --ro-bind "$HOME/.config/jj"             "$HOME/.config/jj"

    # ~/.ssh is intentionally NOT bound. Read access to private keys lets a
    # compromised agent exfiltrate them over the (shared) network. Instead
    # forward only the ssh-agent socket and known_hosts/config below: the
    # agent can sign auth challenges via the agent but cannot read keys.
    --ro-bind-try "$HOME/.ssh/known_hosts"   "$HOME/.ssh/known_hosts"
    --ro-bind-try "$HOME/.ssh/config"        "$HOME/.ssh/config"

    # --- Read-write paths ---
    --bind "$HOME/.moz-phab-config"   "$HOME/.moz-phab-config"
    # Source tree (default $HOME/src, see SRC/CCODE_CWD_ONLY at top).
    # cwd is always rw regardless of CCODE_CWD_ONLY; when cwd is under
    # RW_ROOT the second bind is a no-op overlay.
    --bind "$RW_ROOT"                 "$RW_ROOT"
    --bind "$CWD"                     "$CWD"
    --bind "$HOME/.claude"            "$HOME/.claude"
    --bind "$HOME/.claude.json"       "$HOME/.claude.json"
    --bind "$HOME/.local/share/rr"    "$HOME/.local/share/rr"
    --bind "$HOME/.mozbuild"          "$HOME/.mozbuild"

    # Sandbox-private toolchain caches mounted over the canonical host paths.
    # Inside the sandbox these look like ~/.cargo, ~/.local/share/uv, etc.
    # but the storage is in $HOME/.sandbox/<tool>, separate from the host.
    --bind   "$SBX/cargo"             "$HOME/.cargo"
    --bind   "$SBX/uv"                "$HOME/.local/share/uv"
    # Rust toolchains (rustup-managed): host-shared, read-only. `rustup
    # update` will fail inside the sandbox by design — install toolchains
    # on the host.
    --ro-bind "$HOME/.rustup"         "$HOME/.rustup"

    # Host-installed cargo tools (jj, bat, etc.): mounted read-only at a
    # separate path so the sandbox cannot overwrite them while still being
    # able to use them. The sandbox-private ~/.cargo/bin remains first on
    # PATH so the agent can install its own tools without touching the host.
    --ro-bind "$HOME/.cargo/bin"      /opt/cargo-host/bin

    # --- Virtual filesystems ---
    --tmpfs /tmp
    --proc  /proc
    --dev   /dev

    # --clearenv drops everything from the host environment so secrets
    # (AWS_*, OPENAI_API_KEY, anonymous tokens, etc.) cannot leak into the
    # sandbox. We then re-introduce only the variables the sandbox needs.
    --clearenv
    --setenv HOME    "$HOME"
    --setenv USER    "${USER:-$(id -un)}"
    --setenv LOGNAME "${LOGNAME:-${USER:-$(id -un)}}"
    --setenv SHELL   "${SHELL:-/bin/bash}"
    --setenv TERM    "${TERM:-xterm-256color}"
    --setenv LANG    "${LANG:-C.UTF-8}"
    --setenv PATH    "$HOME/.cargo/bin:$HOME/.local/bin:$SBX/npm-prefix/bin:/opt/cargo-host/bin:/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

    # Point npm/pip/go at sandbox-only caches. cargo and uv use their default
    # locations, which are already mounted to the sandbox dirs above.
    --setenv NPM_CONFIG_CACHE  "$SBX/npm"
    --setenv NPM_CONFIG_PREFIX "$SBX/npm-prefix"
    --setenv PIP_CACHE_DIR     "$SBX/pip"
    --setenv GOPATH            "$SBX/go"
    --setenv GOMODCACHE        "$SBX/go/pkg/mod"

    # Disable all git hook execution inside the sandbox by overriding
    # core.hooksPath to an empty directory. GIT_CONFIG_COUNT/KEY/VALUE layers
    # on top of the user's normal gitconfig, so identity and aliases are
    # preserved.
    #
    # This protects the sandbox from running hooks a previous (compromised)
    # invocation may have written into a repo. It does NOT prevent the
    # sandbox from *writing* malicious hooks for the host's git to execute
    # later — see README for the matching host-side hardening.
    --setenv GIT_CONFIG_COUNT  "1"
    --setenv GIT_CONFIG_KEY_0   "core.hooksPath"
    --setenv GIT_CONFIG_VALUE_0 "$SBX/empty-hooks"
)

# Forward the GitHub token so gh(1) can authenticate inside the sandbox.
# The token lives in the host keyring and is not present in ~/.config/gh,
# so we read it at launch time. This is consistent with the existing bearer-
# token exposure model documented in the README.
if _GH_TOKEN=$(gh auth token 2>/dev/null) && [[ -n "$_GH_TOKEN" ]]; then
    args+=(--setenv GH_TOKEN "$_GH_TOKEN")
fi

[[ -n "${PHABRICATOR_TOKEN:-}" ]] && args+=(--setenv PHABRICATOR_TOKEN "$PHABRICATOR_TOKEN")
[[ -n "${BMO_API_KEY:-}" ]]       && args+=(--setenv BMO_API_KEY       "$BMO_API_KEY")
# MOZCONFIG points to a directory that may contain executables (compilers,
# build tools, wrappers). Like the sandbox-private toolchain caches, a
# compromised agent could drop malicious binaries here for the host to pick
# up later. Accept the residual risk: the directory must be rw so mach can
# write build artefacts into it.
if [[ -n "${MOZCONFIG:-}" ]]; then
    args+=(--bind "$MOZCONFIG" "$MOZCONFIG" --setenv MOZCONFIG "$MOZCONFIG")
fi

# MOZBUILD_STATE_PATH overrides the default ~/.mozbuild for mach build state.
# Validate that it lands inside an already-accessible path; an arbitrary host
# path would otherwise gain rw access inside the sandbox without a bind mount.
if [[ -n "${MOZBUILD_STATE_PATH:-}" ]]; then
    _mbpath="$(realpath -m "$MOZBUILD_STATE_PATH")"
    _mapped=false
    for _prefix in "$HOME/.mozbuild" "$RW_ROOT" "$CWD"; do
        if [[ "$_mbpath" == "$(realpath -m "$_prefix")"* ]]; then
            _mapped=true
            break
        fi
    done
    if [[ "$_mapped" == false ]]; then
        echo "error: destination of MOZBUILD_STATE_PATH=$MOZBUILD_STATE_PATH is outside the sandbox." >&2
        echo "It must be under one of: ~/.mozbuild, $RW_ROOT, or $CWD" >&2
        exit 1
    fi
    args+=(--setenv MOZBUILD_STATE_PATH "$MOZBUILD_STATE_PATH")
fi

# Forward the ssh-agent socket if one is available on the host. The agent
# inside the sandbox can use it for signing (e.g. ssh / git push) but cannot
# read the underlying private keys.
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
    args+=(
        --ro-bind "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK"
        --setenv  SSH_AUTH_SOCK    "$SSH_AUTH_SOCK"
    )
fi

args+=(

    # --- Namespace configuration ---
    # --share-net: keep host network namespace (mach/cargo/gh need it).
    # --unshare-{pid,ipc,uts,cgroup-try}: isolate everything else we can.
    # --unshare-pid hides host PIDs (so the agent cannot kill host processes
    # or read /proc/<host-pid>/*) and gives the sandbox its own PID 1.
    --share-net
    --unshare-pid
    --unshare-ipc
    --unshare-uts
    --unshare-cgroup-try

    # --new-session: detach from the calling terminal's session group so the
    # container cannot signal the host's TTY processes.
    --new-session
    --hostname ccode-sandbox
    # --die-with-parent: SIGKILL the container if the launching shell exits.
    --die-with-parent
)

# bypassPermissions: filesystem restrictions above replace claude's per-tool
# permission prompts. --mcp-config wires up the rr MCP server if present.
# Claude Code stores mcp-servers.json in either ~/.config/claude/ or ~/.claude/
# depending on version/platform; check both and use the first match.
MCP_CONFIG=""
for _candidate in "$HOME/.config/claude/mcp-servers.json" "$HOME/.claude/mcp-servers.json"; do
    if [[ -f "$_candidate" ]]; then
        MCP_CONFIG="$_candidate"
        break
    fi
done

exec bwrap "${args[@]}" \
    "$(command -v claude)" \
    --permission-mode bypassPermissions \
    ${MCP_CONFIG:+--mcp-config "$MCP_CONFIG"} \
    "$@"
